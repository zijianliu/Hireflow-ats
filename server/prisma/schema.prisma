generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  username    String    @unique
  email       String    @unique
  password    String
  name        String
  role        String    @default("HR")
  phone       String?
  avatar      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  jobsOwner            Job[]                @relation("JobOwner")
  jobsParticipant      Job[]                @relation("JobParticipants")
  candidates           Candidate[]          @relation("CandidateOwner")
  interviewsInterview  Interview[]          @relation("Interviewer")
  offers               Offer[]
  timelineEvents       TimelineEvent[]

  @@map("users")
}

model Job {
  id            String    @id @default(cuid())
  title         String
  department    String
  location      String
  headcount     Int
  status        String    @default("RECRUITING")
  description   String
  ownerId       String
  owner         User      @relation("JobOwner", fields: [ownerId], references: [id])
  participants  User[]    @relation("JobParticipants")
  candidates    Candidate[]
  interviews    Interview[]
  offers        Offer[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([title])
  @@index([department])
  @@index([location])
  @@index([status])
  @@index([ownerId])
  @@map("jobs")
}

model Candidate {
  id             String          @id @default(cuid())
  name           String
  phone          String
  email          String
  resumeUrl      String?
  source         String
  jobId          String
  job            Job             @relation(fields: [jobId], references: [id])
  stage          String          @default("SCREENING")
  ownerId        String
  owner          User            @relation("CandidateOwner", fields: [ownerId], references: [id])
  remark         String?
  interviews     Interview[]
  evaluations    InterviewEvaluation[]
  timelineEvents TimelineEvent[]
  offers         Offer[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([jobId, phone])
  @@unique([jobId, email])
  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([jobId])
  @@index([stage])
  @@index([source])
  @@index([ownerId])
  @@map("candidates")
}

model TimelineEvent {
  id           String        @id @default(cuid())
  candidateId  String
  candidate    Candidate     @relation(fields: [candidateId], references: [id])
  actionType   String
  fromStage    String?
  toStage      String?
  operatorId   String
  operator     User          @relation(fields: [operatorId], references: [id])
  description  String?
  createdAt    DateTime      @default(now())

  @@index([candidateId])
  @@index([operatorId])
  @@index([createdAt])
  @@map("timeline_events")
}

model Interview {
  id              String          @id @default(cuid())
  candidateId     String
  candidate       Candidate       @relation(fields: [candidateId], references: [id])
  jobId           String
  job             Job             @relation(fields: [jobId], references: [id])
  round           String
  interviewerId   String
  interviewer     User            @relation("Interviewer", fields: [interviewerId], references: [id])
  startTime       DateTime
  endTime         DateTime
  method          String
  location        String?
  status          String          @default("PENDING")
  evaluation      InterviewEvaluation?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([candidateId])
  @@index([jobId])
  @@index([interviewerId])
  @@index([startTime])
  @@index([status])
  @@map("interviews")
}

model InterviewEvaluation {
  id            String    @id @default(cuid())
  interviewId   String    @unique
  interview     Interview @relation(fields: [interviewId], references: [id])
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id])
  score         Int
  strengths     String
  concerns      String
  passed        Boolean
  remark        String?
  createdAt     DateTime  @default(now())

  @@index([candidateId])
  @@map("interview_evaluations")
}

model Offer {
  id            String    @id @default(cuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id])
  jobId         String
  job           Job       @relation(fields: [jobId], references: [id])
  salaryRange   String
  onboardDate   DateTime
  status        String    @default("PENDING")
  remark        String?
  createdById   String
  createdBy     User      @relation(fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
  @@map("offers")
}
